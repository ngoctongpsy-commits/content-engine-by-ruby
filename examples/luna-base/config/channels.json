{
  "_meta": {
    "profile": "luna-base",
    "description": "Luna Base channels config. Real Directus + Make.com + Telegram setup used by lunabase.ai.",
    "schema_version": "1.0",
    "_secrets_note": "Tokens live in gitignored sibling files: .cms-token, .make-webhook-url, .make-api-config, .notify-config"
  },
  "cms": {
    "provider": "directus",
    "base_url": "https://api.lunabase.ai",
    "token_file": ".cms-token",
    "posts_collection": "posts",
    "fields": {
      "slug": "slug",
      "title": "title",
      "description": "description",
      "body_html": "body_html",
      "thumbnail": "thumbnail",
      "keywords": "keywords",
      "author": "author",
      "status": "status",
      "published_at": "published_at"
    },
    "default_status": "published",
    "public_url_pattern": "https://lunabase.ai/blog/{slug}",
    "image_url_pattern": "https://api.lunabase.ai/assets/{uuid}.png"
  },
  "social": {
    "_comment": "Each channel posts via its `publisher` (default 'make' = the Make.com webhook). Optional `fallback_publisher` is tried automatically if the primary errors (script logs + notifies). Add cheaper publishers in `publishers` as needed.",
    "make_webhook_url_file": ".make-webhook-url",
    "make_api_token_file": ".make-api-token",
    "make_scenario_id": "REPLACE_WITH_SCENARIO_ID",
    "make_base_url": "https://eu1.make.com",
    "publishers": {
      "_comment": "Registry of where channels can post. 'make' = Make.com webhook (Make routes by the channel field). Add a cheap fallback for the hard platforms when needed.",
      "make": {
        "type": "webhook",
        "webhook_url_file": ".make-webhook-url",
        "api_token_file": ".make-api-token",
        "scenario_id": "REPLACE_WITH_SCENARIO_ID",
        "base_url": "https://eu1.make.com"
      },
      "upload-post": {
        "_comment": "CHEAPEST fallback. upload-post.com free tier = 10 posts/month and covers the hard platforms TikTok/Threads/X plus IG/YouTube/FB/LinkedIn (it handles the platform app-approval for you). Sign up, put the API key in config/.upload-post-key, set enabled=true. Leave disabled until you actually need a hard platform.",
        "type": "rest",
        "enabled": false,
        "api_base": "https://api.upload-post.com/api",
        "api_key_file": ".upload-post-key"
      }
    },
    "channels": {
      "linkedin_company": {
        "enabled": true,
        "channel_field_value": "linkedin",
        "publisher": "make",
        "fallback_publisher": "",
        "post_visibility": "PUBLIC",
        "feed_url": "https://www.linkedin.com/company/YOUR-COMPANY-SLUG/"
      },
      "facebook_page": {
        "enabled": true,
        "channel_field_value": "facebook",
        "publisher": "make",
        "fallback_publisher": "",
        "feed_url": "https://www.facebook.com/YOUR-FB-PAGE-SLUG"
      },
      "instagram": {
        "enabled": false,
        "channel_field_value": "instagram",
        "publisher": "make",
        "fallback_publisher": "upload-post",
        "_note": "Needs an IG Business/Creator account linked to a Facebook Page."
      },
      "youtube": {
        "enabled": false,
        "channel_field_value": "youtube",
        "publisher": "make",
        "fallback_publisher": "upload-post",
        "_note": "Video upload (Shorts/long). Needs a video asset from video-production."
      },
      "threads": {
        "enabled": false,
        "channel_field_value": "threads",
        "publisher": "make",
        "fallback_publisher": "upload-post",
        "_note": "Conversational text post."
      },
      "tiktok": {
        "enabled": false,
        "channel_field_value": "tiktok",
        "publisher": "make",
        "fallback_publisher": "upload-post",
        "_note": "TikTok content API is restrictive; upload-post handles approval. Video required."
      },
      "x_twitter": {
        "enabled": false,
        "channel_field_value": "x",
        "publisher": "make",
        "fallback_publisher": "upload-post",
        "_note": "X API can be costly direct; upload-post covers it."
      },
      "pinterest": {
        "enabled": false,
        "channel_field_value": "pinterest",
        "publisher": "make",
        "fallback_publisher": "upload-post",
        "_note": "Pin = image + link."
      },
      "linkedin_personal": {
        "enabled": false,
        "channel_field_value": "linkedin-personal",
        "publisher": "make",
        "fallback_publisher": "",
        "_comment": "Founder personal LinkedIn - often manual."
      }
    }
  },
  "schedule": {
    "_timezone_publish": "Asia/Kolkata",
    "_timezone_generation": "Asia/Ho_Chi_Minh",
    "blog_draft_generation": {
      "cron": "0 2 * * *",
      "_label": "02:02 Vietnam time = 00:32 IST",
      "_description": "Generate 3 next-day drafts (Slot A, B, C)"
    },
    "blog_publish_slot_a": {
      "cron": "30 9 * * *",
      "_label": "09:30 IST = 11:00 VN",
      "_description": "Foundational long-form publish"
    },
    "blog_publish_slot_b": {
      "cron": "30 13 * * *",
      "_label": "13:30 IST = 15:00 VN",
      "_description": "Comparison / how-to publish"
    },
    "blog_publish_slot_c": {
      "cron": "30 17 * * *",
      "_label": "17:30 IST = 19:00 VN",
      "_description": "News commentary publish"
    },
    "weekly_social_generation": {
      "cron": "0 21 * * 1",
      "_label": "Mon 21:00 VN = Mon 19:30 IST",
      "_description": "Cowork generates JSON packet"
    },
    "weekly_social_posting": {
      "cron": "30 11 * * 2",
      "_label": "Tue 11:30 VN = Tue 10:00 IST",
      "_description": "Windows host fires Make webhooks (LinkedIn India peak)"
    }
  },
  "notifications": {
    "telegram": {
      "enabled": true,
      "config_file": ".notify-config",
      "alert_on_publish_success": true,
      "alert_on_publish_failure": true,
      "alert_on_social_post_success": true,
      "alert_on_social_post_failure": true,
      "alert_on_validation_rejection": true,
      "mute_known_transient_errors": [
        "403 from Google Indexing API (DNS verification pending)"
      ]
    }
  }
}